if(NOT DEFINED TOOL OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "Missing preview document test paths")
endif()
string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" suffix)
set(root "${TEST_ROOT}/r324-cli-${suffix}")
file(MAKE_DIRECTORY "${root}")
function(run_expect code)
  execute_process(COMMAND "${TOOL}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "${code}")
    file(REMOVE_RECURSE "${root}")
    message(FATAL_ERROR "CLI exit ${result}, expected ${code}: ${out} ${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()
run_expect(2)
run_expect(0 create "${root}/default.swp")
file(SHA256 "${root}/default.swp" original)
run_expect(1 create "${root}/default.swp")
run_expect(0 inspect "${root}/default.swp")
if(NOT last_output MATCHES "profiles=1" OR
   NOT last_output MATCHES "widget_overrides=0" OR
   NOT last_output MATCHES "runtime_settings=excluded")
  file(REMOVE_RECURSE "${root}")
  message(FATAL_ERROR "Unexpected inspect output: ${last_output}")
endif()
run_expect(0 copy "${root}/default.swp" "${root}/copy.swp")
file(SHA256 "${root}/copy.swp" copied)
if(NOT original STREQUAL copied)
  file(REMOVE_RECURSE "${root}")
  message(FATAL_ERROR "Canonical copy changed bytes")
endif()
run_expect(1 copy "${root}/default.swp" "${root}/copy.swp")
run_expect(1 inspect "${root}/missing.swp")
file(WRITE "${root}/bad.swp" "invalid")
run_expect(1 inspect "${root}/bad.swp")
run_expect(1 copy "${root}/bad.swp" "${root}/rejected.swp")
if(EXISTS "${root}/rejected.swp")
  file(REMOVE_RECURSE "${root}")
  message(FATAL_ERROR "Invalid input produced an output")
endif()
file(SHA256 "${root}/default.swp" after)
if(NOT original STREQUAL after)
  file(REMOVE_RECURSE "${root}")
  message(FATAL_ERROR "Failed overwrite altered original")
endif()
file(REMOVE_RECURSE "${root}")
message(STATUS "R324_PREVIEW_DOCUMENT_CLI_PASS")
